generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GENERAL_ADMIN
  SALES_TEAM
  SOCIAL_TEAM
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  ISSUED
  VOID
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NewsletterCampaignStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  FAILED
}

enum ProductBadge {
  NEW
  BESTSELLER
}

enum RetailerType {
  ONLINE
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  name                 String
  passwordHash         String
  role                 Role                 @default(CUSTOMER)
  isActive             Boolean              @default(true)
  invitationTokenHash  String?              @unique
  invitationExpiresAt  DateTime?
  invitationAcceptedAt DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  orders               Order[]
  auditLogs            AuditLog[]           @relation("AuditActor")
  posts                BlogPost[]           @relation("PostAuthor")
  newsletterCampaigns  NewsletterCampaign[] @relation("NewsletterCampaignAuthor")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  description    String?
  price          Decimal           @db.Decimal(12, 2)
  compareAtPrice Decimal?          @db.Decimal(12, 2)
  currency       String            @default("NGN")
  stock          Int               @default(0)
  status         ProductStatus     @default(DRAFT)
  badge          ProductBadge?
  rating         Decimal?          @db.Decimal(2, 1)
  reviewCount    Int               @default(0)
  isBestSeller   Boolean           @default(false)
  categoryId     String
  category       Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images         ProductImage[]
  retailers      ProductRetailer[]
  retailerClicks RetailerClick[]
  orderItems     OrderItem[]
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([categoryId, status])
  @@index([deletedAt])
  @@index([isBestSeller, status])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  publicId  String?
  alt       String?
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Retailer {
  id         String            @id @default(cuid())
  name       String
  type       RetailerType      @default(ONLINE)
  country    String?
  websiteUrl String?
  priority   Int               @default(0)
  isActive   Boolean           @default(true)
  products   ProductRetailer[]
  clicks     RetailerClick[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([isActive, priority, name])
}

model ProductRetailer {
  id                 String    @id @default(cuid())
  productId          String
  retailerId         String
  externalProductUrl String
  isAvailable        Boolean   @default(true)
  externalPrice      Decimal?  @db.Decimal(12, 2)
  lastCheckedAt      DateTime?
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailer           Retailer  @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([productId, retailerId])
  @@index([productId, isAvailable])
  @@index([retailerId, isAvailable])
}

model Store {
  id           String   @id @default(cuid())
  name         String
  address      String
  city         String?
  state        String?
  country      String
  phone        String?
  email        String?
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  openingHours Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, country, state, city, name])
}

model Order {
  id             String        @id @default(cuid())
  reference      String        @unique
  userId         String?
  email          String
  status         OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus  PaymentStatus @default(PENDING)
  subtotal       Decimal       @db.Decimal(12, 2)
  deliveryFee    Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  billingName    String?
  billingAddress Json?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  invoice        Invoice?
  creditNotes    CreditNote[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, paymentStatus, createdAt])
}

model Invoice {
  id             String        @id @default(cuid())
  orderId        String        @unique
  number         String        @unique
  status         InvoiceStatus @default(ISSUED)
  customerEmail  String
  currency       String
  subtotal       Decimal       @db.Decimal(12, 2)
  deliveryFee    Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  snapshot       Json
  issuedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  creditNotes    CreditNote[]

  @@index([issuedAt])
}

model CreditNote {
  id        String   @id @default(cuid())
  invoiceId String
  orderId   String   @unique
  number    String   @unique
  amount    Decimal  @db.Decimal(12, 2)
  currency  String
  reason    String?
  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([invoiceId, issuedAt])
}

model InvoiceSequence {
  id         String   @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model BlogPost {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?
  category    String     @default("Skincare")
  content     String
  coverUrl    String?
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  authorId    String
  author      User       @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
}

model NewsletterSubscriber {
  id                   String    @id @default(cuid())
  email                String    @unique
  isActive             Boolean   @default(true)
  confirmedAt          DateTime?
  unsubscribeTokenHash String    @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([isActive, createdAt])
}

model NewsletterCampaign {
  id             String                   @id @default(cuid())
  subject        String
  content        String
  status         NewsletterCampaignStatus @default(DRAFT)
  recipientCount Int                      @default(0)
  sentAt         DateTime?
  createdById    String
  createdBy      User                     @relation("NewsletterCampaignAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
}

enum AnnouncementDirection {
  LEFT
  RIGHT
}

model AnnouncementBar {
  id         String                @id
  isActive   Boolean               @default(false)
  content    String
  speed      Int                   @default(40)
  background String                @default("#000000")
  textColor  String                @default("#FFFFFF")
  direction  AnnouncementDirection @default(LEFT)
  link       String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// One click on a "Buy on <retailer>" button. Keyed by product and retailer
/// (not the link row) because product saves recreate their retailer links.
model RetailerClick {
  id         String   @id @default(cuid())
  productId  String
  retailerId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailer   Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([retailerId, createdAt])
  @@index([productId, createdAt])
}
