DATABASE_URL=""
DIRECT_URL=""
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
OPENAI_API_KEY=
# Beauty assistant (Google AI Studio key). GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
RESEND_API_KEY=
RESEND_FROM_EMAIL="Caring Chemistry <team@example.com>"
# Signs newsletter unsubscribe links. Keep it stable: changing it breaks links in emails already sent.
NEWSLETTER_UNSUBSCRIBE_SECRET="replace-with-a-long-random-secret"
APP_URL="http://localhost:3000"
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
CLOUDINARY_PRODUCT_FOLDER="caring-chemistry/products"
MAX_IMAGE_UPLOAD_BYTES=10485760
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Header your host sets with the real client IP, used for rate limiting (e.g. x-vercel-forwarded-for on Vercel,
# cf-connecting-ip behind Cloudflare). Leave empty to use the last X-Forwarded-For entry added by your proxy.
TRUSTED_IP_HEADER=
# Newsletter sending. "background" (for Netlify) runs sends in netlify/functions/send-newsletter-background.mts;
# leave empty to send inside the admin request (local dev, Vercel). The job secret must be 32+ random characters.
NEWSLETTER_SEND_MODE=
NEWSLETTER_JOB_SECRET=
